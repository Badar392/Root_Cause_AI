# ── Core AI engine (required) ────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Admin access (optional) ──────────────────────────────────────────────
# Entering this passcode in the sidebar unlocks admin mode for the session:
# AI-config visibility, model override, and alerting/connector status.
# Leave unset to disable admin mode entirely.
ADMIN_PASSCODE=

# ── Alerting / webhooks (optional — either or both) ──────────────────────
# Auto-notifies when a run confirms a High/Critical severity finding.
SLACK_WEBHOOK_URL=

ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_USE_TLS=true

# ── Data connectors (optional — configure only what you use) ─────────────
# SQL database (sqlite path/URL works with no extra dependency;
# postgresql://... / mysql://... require the optional `sqlalchemy` package)
DATABASE_URL=

# Stripe (secret key, read-only "charges" access is sufficient)
STRIPE_API_KEY=

# GA4 (Data API; requires the optional `google-analytics-data` +
# `google-auth` packages — see requirements.txt)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
